from django.shortcuts import render, redirect, get_object_or_404
from django.contrib.auth.decorators import login_required
from django.contrib import messages
from django.http import HttpResponse, JsonResponse
from django.utils import timezone
from django.core.paginator import Paginator
from django.db.models import Sum, Count
import csv
import json
from datetime import datetime, timedelta
from .models import Report, ReportSchedule, ReportTemplate
from .services import ReportService
from .exporters import ReportExporter

@login_required
def index(request):
    """Report dashboard"""
    reports = Report.objects.filter(generated_by=request.user).order_by('-created_at')[:10]
    schedules = ReportSchedule.objects.filter(is_active=True)
    
    total_reports = Report.objects.filter(generated_by=request.user).count()
    pending_reports = Report.objects.filter(
        generated_by=request.user,
        status='pending'
    ).count()
    
    context = {
        'title': 'Reports',
        'reports': reports,
        'schedules': schedules,
        'total_reports': total_reports,
        'pending_reports': pending_reports,
    }
    return render(request, 'reports/index.html', context)


@login_required
def dashboard(request):
    """Reports dashboard view"""
    from members.models import Member
    from finance.models import Payment
    from meetings.models import Meeting
    from compliance.models import ComplianceScore
    from welfare.models import BereavementEvent
    
    total_members = Member.objects.count()
    active_members = Member.objects.filter(status='active').count()
    total_payments = Payment.objects.filter(status='completed').aggregate(
        total=Sum('amount')
    )['total'] or 0
    total_meetings = Meeting.objects.count()
    total_welfare = BereavementEvent.objects.filter(status='active').count()
    
    green = ComplianceScore.objects.filter(status='green').count()
    yellow = ComplianceScore.objects.filter(status='yellow').count()
    red = ComplianceScore.objects.filter(status='red').count()
    
    context = {
        'title': 'Reports Dashboard',
        'total_members': total_members,
        'active_members': active_members,
        'total_payments': total_payments,
        'total_meetings': total_meetings,
        'total_welfare': total_welfare,
        'green': green,
        'yellow': yellow,
        'red': red,
        'compliance_rate': (green / total_members * 100) if total_members > 0 else 0,
    }
    return render(request, 'reports/dashboard.html', context)


@login_required
def member_report(request):
    """Generate member report"""
    from members.models import Member
    
    members = Member.objects.all().order_by('-date_joined')
    
    status_filter = request.GET.get('status')
    if status_filter:
        members = members.filter(status=status_filter)
    
    start_date = request.GET.get('start_date')
    end_date = request.GET.get('end_date')
    if start_date:
        members = members.filter(date_joined__date__gte=start_date)
    if end_date:
        members = members.filter(date_joined__date__lte=end_date)
    
    if request.GET.get('export') == 'csv':
        response = HttpResponse(content_type='text/csv')
        response['Content-Disposition'] = f'attachment; filename="member_report_{datetime.now().strftime("%Y%m%d")}.csv"'
        
        writer = csv.writer(response)
        writer.writerow(['Member ID', 'Name', 'Phone', 'Email', 'Status', 'Compliance', 'Joined'])
        
        for member in members:
            writer.writerow([
                member.member_id,
                member.get_full_name(),
                member.user.phone,
                member.user.email or '',
                member.status,
                member.compliance_status,
                member.date_joined.strftime('%Y-%m-%d')
            ])
        return response
    
    context = {
        'title': 'Member Report',
        'members': members,
        'total': members.count(),
        'active': members.filter(status='active').count(),
        'pending': members.filter(status='pending').count(),
    }
    return render(request, 'reports/member_statement.html', context)


@login_required
def payment_report(request):
    """Generate payment report"""
    from finance.models import Payment
    
    payments = Payment.objects.filter(status='completed').order_by('-created_at')
    
    start_date = request.GET.get('start_date')
    end_date = request.GET.get('end_date')
    if start_date:
        payments = payments.filter(created_at__date__gte=start_date)
    if end_date:
        payments = payments.filter(created_at__date__lte=end_date)
    
    category_filter = request.GET.get('category')
    if category_filter:
        payments = payments.filter(category__id=category_filter)
    
    total_amount = payments.aggregate(total=Sum('amount'))['total'] or 0
    
    if request.GET.get('export') == 'csv':
        response = HttpResponse(content_type='text/csv')
        response['Content-Disposition'] = f'attachment; filename="payment_report_{datetime.now().strftime("%Y%m%d")}.csv"'
        
        writer = csv.writer(response)
        writer.writerow(['Member', 'Category', 'Amount', 'Method', 'Date'])
        
        for payment in payments:
            writer.writerow([
                payment.member.get_full_name(),
                payment.category.name,
                payment.amount,
                payment.get_payment_method_display(),
                payment.created_at.strftime('%Y-%m-%d %H:%M')
            ])
        return response
    
    context = {
        'title': 'Payment Report',
        'payments': payments[:100],
        'total': payments.count(),
        'total_amount': total_amount,
        'start_date': start_date,
        'end_date': end_date,
    }
    return render(request, 'reports/payment_summary.html', context)


@login_required
def attendance_report(request):
    """Generate attendance report"""
    from meetings.models import Meeting, Attendance
    
    meetings = Meeting.objects.all().order_by('-date')
    
    start_date = request.GET.get('start_date')
    end_date = request.GET.get('end_date')
    if start_date:
        meetings = meetings.filter(date__date__gte=start_date)
    if end_date:
        meetings = meetings.filter(date__date__lte=end_date)
    
    attendance_data = []
    for meeting in meetings:
        attendees = Attendance.objects.filter(meeting=meeting)
        attendance_data.append({
            'meeting': meeting,
            'present': attendees.filter(status='present').count(),
            'absent': attendees.filter(status='absent').count(),
            'excused': attendees.filter(status='excused').count(),
            'total': attendees.count(),
        })
    
    context = {
        'title': 'Attendance Report',
        'attendance_data': attendance_data,
        'total_meetings': meetings.count(),
        'start_date': start_date,
        'end_date': end_date,
    }
    return render(request, 'reports/attendance_summary.html', context)


@login_required
def compliance_report(request):
    """Generate compliance report"""
    from compliance.models import ComplianceScore
    
    scores = ComplianceScore.objects.all().order_by('-score')
    
    status_filter = request.GET.get('status')
    if status_filter:
        scores = scores.filter(status=status_filter)
    
    context = {
        'title': 'Compliance Report',
        'scores': scores,
        'total': scores.count(),
        'green': scores.filter(status='green').count(),
        'yellow': scores.filter(status='yellow').count(),
        'red': scores.filter(status='red').count(),
    }
    return render(request, 'reports/compliance_summary.html', context)


@login_required
def welfare_report(request):
    """Generate welfare report"""
    from welfare.models import BereavementEvent
    
    events = BereavementEvent.objects.all().order_by('-created_at')
    
    status_filter = request.GET.get('status')
    if status_filter:
        events = events.filter(status=status_filter)
    
    total_collected = events.aggregate(total=Sum('amount_collected'))['total'] or 0
    total_target = events.aggregate(total=Sum('collection_target'))['total'] or 0
    
    context = {
        'title': 'Welfare Report',
        'events': events,
        'total': events.count(),
        'total_collected': total_collected,
        'total_target': total_target,
        'completion_rate': (total_collected / total_target * 100) if total_target > 0 else 0,
    }
    return render(request, 'reports/bereavement_summary.html', context)


@login_required
def generate_report(request):
    """Generate a report"""
    from finance.models import PaymentCategory
    from .services import ReportService
    import json
    
    if request.method == 'POST':
        report_type = request.POST.get('report_type')
        format_type = request.POST.get('format', 'pdf')
        filters = request.POST.get('filters', '{}')
        
        try:
            filters_data = json.loads(filters) if filters else {}
        except:
            filters_data = {}
        
        report = Report.objects.create(
            report_type=report_type,
            title=f"{report_type.title()} Report - {timezone.now().strftime('%Y-%m-%d %H:%M')}",
            generated_by=request.user,
            filters=filters_data,
            status='pending'
        )
        
        try:
            report.mark_generating()
            service = ReportService()
            result = service.generate_report(report.id)
            report.mark_completed()
            
            # Generate file
            exporter = ReportExporter(result, report.title)
            response = exporter.to_csv()
            
            # Save file to report
            from django.core.files.base import ContentFile
            content = response.content
            report.file.save(f"{report.title}.csv", ContentFile(content))
            report.save()
            
            messages.success(request, 'Report generated successfully!')
        except Exception as e:
            report.mark_failed(str(e))
            messages.error(request, f'Error generating report: {str(e)}')
        
        return redirect('reports:detail', report_id=report.id)
    
    categories = PaymentCategory.objects.filter(is_active=True)
    
    context = {
        'title': 'Generate Report',
        'categories': categories,
    }
    return render(request, 'reports/generate.html', context)


@login_required
def download_report(request, report_id):
    """Download a generated report"""
    report = get_object_or_404(Report, id=report_id, generated_by=request.user)
    
    if report.status != 'completed':
        messages.error(request, 'Report is not ready for download yet.')
        return redirect('reports:detail', report_id=report.id)
    
    # If file exists, serve it
    if report.file:
        response = HttpResponse(report.file.read(), content_type='application/octet-stream')
        response['Content-Disposition'] = f'attachment; filename="{report.file.name}"'
        return response
    
    # Generate file on the fly
    try:
        exporter = ReportExporter(report.data, report.title)
        
        if report.report_type == 'member':
            response = exporter.to_csv()
        elif report.report_type == 'payment':
            response = exporter.to_csv()
        elif report.report_type == 'compliance':
            response = exporter.to_csv()
        else:
            response = exporter.to_csv()
        
        return response
    except Exception as e:
        messages.error(request, f'Error downloading report: {str(e)}')
        return redirect('reports:detail', report_id=report.id)


@login_required
def report_detail(request, report_id):
    """View report details"""
    report = get_object_or_404(Report, id=report_id, generated_by=request.user)
    
    context = {
        'title': f'Report: {report.title}',
        'report': report,
    }
    return render(request, 'reports/detail.html', context)


@login_required
def delete_report(request, report_id):
    """Delete a report"""
    report = get_object_or_404(Report, id=report_id, generated_by=request.user)
    
    if request.method == 'POST':
        report.delete()
        messages.success(request, 'Report deleted successfully!')
        return redirect('reports:index')
    
    context = {
        'report': report,
        'title': 'Delete Report',
    }
    return render(request, 'reports/delete.html', context)

@login_required
def generate_report(request):
    """Generate a report"""
    from finance.models import PaymentCategory
    from .services import ReportService
    from .exporters import ReportExporter
    import json
    
    if request.method == 'POST':
        report_type = request.POST.get('report_type')
        format_type = request.POST.get('format', 'csv')
        filters = request.POST.get('filters', '{}')
        
        try:
            filters_data = json.loads(filters) if filters else {}
        except:
            filters_data = {}
        
        # Create report
        report = Report.objects.create(
            report_type=report_type,
            title=f"{report_type.title()} Report - {timezone.now().strftime('%Y-%m-%d %H:%M')}",
            generated_by=request.user,
            filters=filters_data,
            status='pending'
        )
        
        try:
            report.mark_generating()
            service = ReportService()
            data = service.generate_report(report.id)
            report.mark_completed()
            report.data = data
            report.save()
            
            # Generate file based on format
            exporter = ReportExporter(data, report.title, format_type)
            response = exporter.export()
            
            # Save file to report (optional)
            from django.core.files.base import ContentFile
            content = response.content
            ext = format_type if format_type != 'excel' else 'xlsx'
            report.file.save(f"{report.title}.{ext}", ContentFile(content))
            report.save()
            
            messages.success(request, f'Report generated successfully in {format_type.upper()} format!')
            
            # Return file download directly
            return response
            
        except Exception as e:
            report.mark_failed(str(e))
            messages.error(request, f'Error generating report: {str(e)}')
            return redirect('reports:detail', report_id=report.id)
    
    categories = PaymentCategory.objects.filter(is_active=True)
    
    context = {
        'title': 'Generate Report',
        'categories': categories,
    }
    return render(request, 'reports/generate.html', context)
